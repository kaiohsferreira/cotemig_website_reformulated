# Normaliza fim de linha: LF no repositorio, nativo na copia de trabalho.
# Sem isto, quem trabalha no Windows commita CRLF e o diff fica poluido.
* text=auto eol=lf

# Binarios — git nao deve tentar converter nada.
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Gerados por script: colapsa no diff da revisao.
src/data/posts-index.json   linguist-generated=true
src/data/posts-bodies.json  linguist-generated=true
package-lock.json           linguist-generated=true
